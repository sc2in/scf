{
  "control_id": "IRO-16",
  "title": "Incident Stakeholder Reporting",
  "family": "IRO",
  "description": "Mechanisms exist to timely-report incidents to applicable:\n(1) Internal stakeholders; \n(2) Affected clients & third-parties; and\n(3) Regulatory authorities.",
  "scf_question": "Does the organization timely-report incidents to applicable:\n (1) Internal stakeholders; \n (2) Affected clients & third-parties; and\n (3) Regulatory authorities?",
  "relative_weight": 9,
  "conformity_cadence": "Annual",
  "evidence_requests": [
    "E-IRO-11"
  ],
  "pptdf": "Process",
  "nist_csf_function": "Respond",
  "scrm_focus": {
