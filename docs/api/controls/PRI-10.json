{
  "control_id": "PRI-10",
  "title": "Security of Personal Data (PD)",
  "family": "PRI",
  "description": "Mechanisms exist to ensure Personal Data (PD) is protected by logical and physical security safeguards that are sufficient and appropriately scoped to protect the confidentiality and integrity of the PD.",
  "scf_question": "Does the organization ensure Personal Data (PD) is protected by logical and physical security safeguards that are sufficient and appropriately scoped to protect the confidentiality and integrity of the PD?",
  "relative_weight": 7,
  "conformity_cadence": "Annual",
  "evidence_requests": [],
  "pptdf": "Data",
  "nist_csf_function": "Protect",
  "scrm_focus": {
