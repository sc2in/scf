{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scf-assessment-objectives.json",
  "type": "object",
  "required": ["total", "assessment_objectives"],
  "properties": {
    "total": {"type": "integer"},
    "assessment_objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scf_control_id", "ao_id", "objective", "pptdf", "origin",
          "assessment_rigor", "scf_defined_parameters", "org_defined_parameters"
        ],
        "properties": {
          "scf_control_id": {"type": "string", "minLength": 1},
          "ao_id": {"type": "string", "minLength": 1},
          "objective": {"type": "string"},
          "pptdf": {"type": "string"},
          "origin": {"type": "string"},
          "assessment_rigor": {"type": "string"},
          "scf_defined_parameters": {"type": "string"},
          "org_defined_parameters": {"type": "string"}
        }
      }
    }
  }
}
