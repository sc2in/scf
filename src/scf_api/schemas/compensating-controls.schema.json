  "definitions": {
    "ccBlock": {
      "type": ["object", "null"],
      "required": ["control_id", "name", "description", "justification"],
      "properties": {
        "control_id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "justification": {"type": "string"}
      }
    }
  },
  "properties": {
    "total": {"type": "integer"},
    "compensating_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control_id", "risk_if_not_implemented", "compensating_control_1"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "risk_if_not_implemented": {"type": "string"},
          "compensating_control_1": {"$ref": "#/definitions/ccBlock"},
          "compensating_control_2": {"$ref": "#/definitions/ccBlock"}
