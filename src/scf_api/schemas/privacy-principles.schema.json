{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scf-privacy-principles.json",
  "type": "object",
  "required": ["total", "privacy_principles"],
  "properties": {
    "total": {"type": "integer"},
    "privacy_principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["principle_name", "description", "scf_control", "scf_control_id", "crosswalks"],
        "properties": {
          "principle_name": {"type": "string"},
          "description": {"type": "string"},
          "scf_control": {"type": "string"},
          "scf_control_id": {"type": "string", "minLength": 1},
          "crosswalks": {
            "type": "object",
            "additionalProperties": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
